# BigWigs packager metadata, prepared for CurseForge and Wago. Nothing uploads from this repo yet:
# the GitHub release zip is built by scripts/package.sh.
# The release ships three sibling folders: WoWCompanion, WoWCompanion_Digest, WoWCompanion_Answers.
package-as: WoWCompanion

ignore:
  - tests
  - docs
  - scripts
  - Makefile
  - README.md
  - .github
  - dist
